PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lumo-lens
# Khoa app gui kem moi request (header x-app-key). Sinh bang: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_KEY=
# Khoa quan tri rieng cho API them/sua/xoa model (header x-admin-key). De trong thi khong CRUD duoc model nao
ADMIN_KEY=
# Chi dung khi model trong DB de trong baseUrl hoac apiKey
REVID_BASE_URL=https://revidapi.com
REVID_API_KEY=
