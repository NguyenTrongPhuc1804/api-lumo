PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lumo-lens
# Khoa app gui kem request lay danh sach model (header x-app-key). Sinh bang: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_KEY=
# Domain HTTPS cong khai, dung de dung redirect URI cho OAuth
OAUTH_REDIRECT_BASE=https://your-domain.example
# Deep link quay ve app sau khi dang nhap xong
APP_DEEP_LINK=lumolens://auth
# Bi mat ky token dang nhap. Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# OAuth Client ID + Secret loai Web application trong Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email tai khoan admin, cach nhau dau phay. Chi nang quyen, khong tu ha quyen
ADMIN_EMAILS=
# Web admin: danh sach origin chinh xac, cach nhau bang dau phay, khong kem duong dan.
# Production chi nen liet ke cac origin admin HTTPS tin cay.
ADMIN_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_WEB_USERNAME=
# Dinh dang scrypt: salt hex 16 byte, dau hai cham, khoa dan xuat hex 64 byte.
ADMIN_WEB_PASSWORD_HASH=
# So luot dich moi ngay cho tai khoan free
FREE_DAILY_LIMIT=100
# Bat tam thoi de chan doan luong luu/doc cau hinh model Free va Guest.
DEBUG_QUOTA_POLICY=false
# Chi bat sau khi kiem thu vi xu tren MongoDB replica set.
COIN_PAYMENTS_ENABLED=false
# Enable after migrating old Android clients to basic on-device translation.
REQUIRE_PAID_AI=false
# Play Console: gói tự gia hạn hàng tháng, chưa hỗ trợ trial/offer.
PLAY_PRO_ENABLED=false
PLAY_PRO_PRODUCT_ID=lumo_pro
PLAY_PRO_BASE_PLAN_ID=monthly
PLAY_PRO_MONTHLY_COINS=
PLAY_PRO_ALLOW_TEST=false
# Đường dẫn tuyệt đối tới JSON service account, không lưu key vào Git.
GOOGLE_APPLICATION_CREDENTIALS=
# Pub/Sub push có xác thực OIDC. Audience phải khớp cấu hình push.
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT=
PLAY_RTDN_SUBSCRIPTION=
# Khoa HMAC rieng cua bo dem han muc. Dung cung gia tri tren moi instance.
QUOTA_HMAC_SECRET=
# Origin HTTPS cho mọi nhà cung cấp AI, cách nhau bằng dấu phẩy, không kèm path hay dấu / cuối.
# Mỗi model phải có Base URL và API key riêng. Danh sách trống sẽ chặn mọi request AI.
AI_PROVIDER_ALLOWED_ORIGINS=
